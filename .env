# .env.example for frontend apps (Vite uses VITE_ prefix)

# Backend API base URL
VITE_BACKEND_URL=http://localhost:5000/api/raaspay

# Public blockchain RPC (safe)
VITE_XDC_RPC_URL=https://rpc.apothem.network

# Gold oracle contract address (public)
VITE_GOLD_ORACLE_CONTRACT_ADDRESS=0xYourContractAddress
